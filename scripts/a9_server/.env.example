# Ключи и адрес камеры (пример — замените IP на адрес вашей камеры)
A9_PREKEY=0123456789abcdef0123456789abcdef
CAMERA_IP=192.168.1.100
DEFAULT_QUALITY=HD

# Привязка HTTP-сервера (127.0.0.1 — только локально/туннель, 0.0.0.0 — вся локальная сеть)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Защита веб-доступа (HTTP Basic Auth)
WEB_USER=admin
WEB_PASS=change_me_2026

# Локальный видеорегистратор (NVR) и датчик движения
NVR_ENABLED=0
NVR_MOTION=0
NVR_DIR=/storage/emulated/0/Download/Cam_Records
NVR_SEG_MIN=10
NVR_MAX_MB=5120

# Push-уведомления о смене ссылки (ntfy.sh / Telegram)
NTFY_TOPIC=cam_a9_demo_0000
TG_TOKEN=
TG_CHAT_ID=
