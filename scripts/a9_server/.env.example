# ==============================================================================
# КОНФИГУРАЦИЯ ЛОКАЛЬНОГО СЕРВЕРА И NVR ДЛЯ КАМЕРЫ A9 / ANYKA AK3918 / PPFT
# ==============================================================================
# Отредактируйте параметры ниже под свою камеру и сеть перед запуском start.sh.

# --- 1. ПОДКЛЮЧЕНИЕ И АВТОРИЗАЦИЯ КАМЕРЫ (PPRPC / LanAuth) ---
# Локальный IP-адрес камеры в вашей домашней Wi-Fi сети (закрепите его в DHCP роутера)
CAMERA_IP=192.168.1.100

# Серийный номер (DID) вашей камеры вида PPFT... (указан на корпусе или в приложении FtyCamPro)
CAMERA_DID=PPFT00000000000000

# Общий 32-символьный hex-ключ шифрования протокола для этой линейки прошивок (менять не нужно)
A9_PREKEY=A2r0i1m1a2M0a1x6toriQue

# --- 2. НАСТРОЙКИ ВИДЕОПОТОКА И ВЕБ-СЕРВЕРА ---
# Профиль качества видео при запуске: HD (высокое) или SD (экономичное)
DEFAULT_QUALITY=HD

# Порт локального HTTP-веб-сервера (по умолчанию 8080 -> http://127.0.0)
HTTP_PORT=8080

# --- 3. ЛОКАЛЬНЫЙ ВИДЕОРЕГИСТРАТОР (NVR) ---
# Постоянная циклическая запись при старте: 1 = включена, 0 = выключена (управляется и из меню NVR)
NVR_ENABLED=0

# Папка для сохранения видеозаписей (.ts)
NVR_DIR=/storage/emulated/0/Download/Cam_Records

# Длительность одного видеофайла при постоянной записи (в минутах)
NVR_SEG_MIN=10

# Максимальный объём архива на диске в мегабайтах (при превышении старые файлы удаляются автоматически)
NVR_MAX_MB=5120

# --- 4. ПРОГРАММНЫЙ ДАТЧИК ДВИЖЕНИЯ ---
# Автоматическая запись 45-секундных роликов (motion_*.ts) при движении в кадре:
# 0 = выключен, 1 = низкая чувствительность, 2 = средняя, 3 = высокая
NVR_MOTION=1

# --- 5. ТОЧКИ ОБЗОРА (PTZ) И РЕЖИМ ПАТРУЛИРОВАНИЯ ---
# Координаты 4 точек обзора (формат X,Y в секундах хода мотора; записываются автоматически из меню "Камера")
PSP_1=6.0,3.0
PSP_2=6.0,3.0
PSP_3=6.0,3.0
PSP_4=6.0,3.0

# Последняя сохранённая позиция моторов камеры (обновляется автоматически)
CUR_POS=6.0,3.0

# Автоматический круговой обход записанных точек при запуске: 1 = включён, 0 = выключен
PATROL_ON=0

# Пауза на каждой точке во время патрулирования (в секундах, минимум 5)
PATROL_SEC=15

# --- 6. УДАЛЁННЫЙ ДОСТУП И PUSH-УВЕДОМЛЕНИЯ (ntfy.sh / Telegram) ---
# Имя вашего личного канала в приложении ntfy (https://ntfy.sh) для получения ссылки туннеля и тревог движения
# Пример: my_home_cam_9911 (оставьте пустым, чтобы отключить уведомления ntfy)
NTFY_TOPIC=

# Опционально: токен бота и ID чата Telegram для дублирования уведомлений
TG_TOKEN=
TG_CHAT_ID=
